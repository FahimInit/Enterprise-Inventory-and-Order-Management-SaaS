# =============================================================================
# Enterprise Inventory & Order Management SaaS — Environment Configuration Template
# Copy this file to .env for local development. Never commit real secrets.
# =============================================================================

# --- PostgreSQL Database ---
POSTGRES_HOST=inventory-db
POSTGRES_PORT=5432
POSTGRES_DB=enterprise_inventory_db
POSTGRES_USER=inventory_app
POSTGRES_PASSWORD=CHANGE_ME_LOCAL_DEV_PASSWORD_ONLY

# --- ASP.NET Core API ---
ASPNETCORE_ENVIRONMENT=Development
API_PORT=8080
ConnectionStrings__DefaultConnection=Host=localhost;Port=5432;Database=enterprise_inventory_db;Username=inventory_app;Password=CHANGE_ME_LOCAL_DEV_PASSWORD_ONLY

# --- JWT Authentication ---
Jwt__Issuer=EnterpriseInventorySaaS
Jwt__Audience=EnterpriseInventorySaaS.Clients
Jwt__SecretKey=REPLACE_WITH_AT_LEAST_32_BYTE_CRYPTOGRAPHICALLY_RANDOM_SECRET_KEY
Jwt__AccessTokenExpirationMinutes=30
Jwt__RefreshTokenExpirationDays=14

# --- CORS ---
Cors__AllowedOrigins__0=http://localhost:3000

# --- Background Services ---
BackgroundJobs__EnableLowStockMonitor=true
BackgroundJobs__LowStockCheckIntervalMinutes=15
BackgroundJobs__EnableReconciliationMonitor=true
BackgroundJobs__ReconciliationIntervalMinutes=60

# --- Demo / Initial Seed (Optional, strictly identified as Demo when enabled) ---
Seed__EnableDemoData=true

# --- Next.js Frontend ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080/api/v1
INTERNAL_API_BASE_URL=http://inventory-api:8080/api/v1
FRONTEND_PORT=3000
