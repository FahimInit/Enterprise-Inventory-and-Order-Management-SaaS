{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
      }
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=enterprise_inventory_db;Username=inventory_app;Password=CHANGE_ME_LOCAL_DEV_PASSWORD_ONLY"
  },
  "Jwt": {
    "Issuer": "EnterpriseInventorySaaS",
    "Audience": "EnterpriseInventorySaaS.Clients",
    "SecretKey": "DEV_ONLY_REPLACE_IN_PRODUCTION_WITH_LONG_CRYPTOGRAPHIC_KEY_64_BYTES",
    "AccessTokenExpirationMinutes": 30,
    "RefreshTokenExpirationDays": 14
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:3000"
    ]
  },
  "BackgroundJobs": {
    "EnableLowStockMonitor": true,
    "LowStockCheckIntervalMinutes": 15,
    "EnableReconciliationMonitor": true,
    "ReconciliationIntervalMinutes": 60
  },
  "Seed": {
    "EnableDemoData": false
  },
  "AllowedHosts": "*"
}
